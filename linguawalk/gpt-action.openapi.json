{
  "openapi": "3.1.0",
  "info": {
    "title": "LinguaWalk Learning Memory API",
    "version": "3.1.0",
    "description": "Stores and retrieves one learner's LinguaWalk sessions, observed vocabulary and grammar events, adaptive targets, profile, and progress."
  },
  "paths": {
    "/profile": {
      "get": {
        "summary": "Get learner profile",
        "operationId": "getLearnerProfile",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearnerProfile"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "description": "Read the learner's baseline, CEFR levels, strengths, weaknesses, learning-method preferences, and current item counts.",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/progress": {
      "get": {
        "summary": "Get learning progress",
        "operationId": "getLearningProgress",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearningProgress"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "description": "Read lifetime session and event totals, current vocabulary and grammar state, and the latest weekly and monthly summaries.",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/learning/targets": {
      "get": {
        "summary": "Get due learning targets",
        "operationId": "getLearningTargets",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearningTargets"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "description": "Get vocabulary and grammar items currently due for natural review, including priorities, reasons, and recommended methods.",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/session/start": {
      "post": {
        "summary": "Start a learning session",
        "operationId": "startSession",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartSessionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartSessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "description": "Create a LinguaWalk session and return its server-owned ID together with the learner profile, due targets, and maintenance state.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-openai-isConsequential": false
      }
    },
    "/vocabulary/event": {
      "post": {
        "summary": "Record a vocabulary event",
        "operationId": "recordVocabularyEvent",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VocabularyEventRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VocabularyEventResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "description": "Record one observed vocabulary learning event for the active session and return the updated vocabulary item state.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-openai-isConsequential": false
      }
    },
    "/grammar/event": {
      "post": {
        "summary": "Record a grammar event",
        "operationId": "recordGrammarEvent",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GrammarEventRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GrammarEventResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "description": "Record one observed grammar learning event for the active session and return the updated grammar item state.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-openai-isConsequential": false
      }
    },
    "/session/end": {
      "post": {
        "summary": "End a learning session",
        "operationId": "endSession",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EndSessionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EndSessionResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "description": "Close a LinguaWalk session with its subjects, summary, and learner notes, then return stored closure and event counts.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-openai-isConsequential": false
      }
    }
  },
  "components": {
    "schemas": {
      "EndSessionRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "title": "Session Id"
          },
          "subjects": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Subjects"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10000
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "learner_notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10000
              },
              {
                "type": "null"
              }
            ],
            "title": "Learner Notes"
          }
        },
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "EndSessionRequest"
      },
      "EndSessionResult": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "started_at": {
            "type": "string",
            "title": "Started At"
          },
          "ended_at": {
            "type": "string",
            "title": "Ended At"
          },
          "already_ended": {
            "type": "boolean",
            "title": "Already Ended"
          },
          "subjects": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Subjects"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "learner_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Learner Notes"
          },
          "vocabulary_event_count": {
            "type": "integer",
            "title": "Vocabulary Event Count",
            "default": 0
          },
          "grammar_event_count": {
            "type": "integer",
            "title": "Grammar Event Count",
            "default": 0
          },
          "total_event_count": {
            "type": "integer",
            "title": "Total Event Count",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "success",
          "session_id",
          "started_at",
          "ended_at",
          "already_ended"
        ],
        "title": "EndSessionResult"
      },
      "GrammarEventRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "language": {
            "type": "string",
            "enum": [
              "FRENCH",
              "ENGLISH"
            ],
            "title": "Language",
            "default": "FRENCH"
          },
          "key": {
            "type": "string",
            "title": "Key"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "LEARNING_ERROR",
              "RECURRING_ERROR",
              "CORRECT_USAGE",
              "NATURAL_SUCCESS",
              "SPONTANEOUS_SUCCESS",
              "REACTIVATION_SUCCESS",
              "REACTIVATION_FAILURE"
            ],
            "title": "Event Type"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "usefulness_score": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 5.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Usefulness Score"
          },
          "session_subject": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Subject"
          },
          "event_subject": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Subject"
          },
          "user_form": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Form"
          },
          "correct_form": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correct Form"
          },
          "explanation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation"
          },
          "review_method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review Method"
          },
          "hint_level": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Hint Level",
            "default": 0
          },
          "retrieval_speed": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "FAST",
                  "HESITANT",
                  "VERY_HESITANT",
                  "FAILED"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Retrieval Speed"
          },
          "agent_prompted_target": {
            "type": "boolean",
            "title": "Agent Prompted Target",
            "default": false
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "occurred_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occurred At"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "key",
          "event_type"
        ],
        "title": "GrammarEventRequest"
      },
      "GrammarEventResult": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "key": {
            "type": "string",
            "title": "Key"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "IMPROVING",
              "STABLE"
            ],
            "title": "Status"
          },
          "usefulness_score": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Usefulness Score"
          },
          "correct_usage_count": {
            "type": "integer",
            "title": "Correct Usage Count",
            "default": 0
          },
          "mistake_count_total": {
            "type": "integer",
            "title": "Mistake Count Total",
            "default": 0
          },
          "recent_correct_count": {
            "type": "integer",
            "title": "Recent Correct Count",
            "default": 0
          },
          "recent_mistake_count": {
            "type": "integer",
            "title": "Recent Mistake Count",
            "default": 0
          },
          "error_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Error Rate"
          },
          "recent_error_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Recent Error Rate"
          },
          "priority_score": {
            "type": "number",
            "title": "Priority Score",
            "default": 0.0
          },
          "last_mistake_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Mistake At"
          },
          "last_success_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Success At"
          }
        },
        "type": "object",
        "required": [
          "success",
          "key",
          "status",
          "usefulness_score",
          "error_rate",
          "recent_error_rate"
        ],
        "title": "GrammarEventResult"
      },
      "GrammarTarget": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "usefulness_score": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Usefulness Score"
          },
          "correct_usage_count": {
            "type": "integer",
            "title": "Correct Usage Count",
            "default": 0
          },
          "mistake_count": {
            "type": "integer",
            "title": "Mistake Count",
            "default": 0
          },
          "error_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Error Rate",
            "default": 0.0
          },
          "priority_score": {
            "type": "number",
            "title": "Priority Score",
            "default": 0.0
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "IMPROVING",
              "STABLE"
            ],
            "title": "Status"
          },
          "last_mistake": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Mistake"
          },
          "last_success": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Success"
          },
          "next_review_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Review At"
          },
          "recommended_method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommended Method"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "key",
          "usefulness_score",
          "status"
        ],
        "title": "GrammarTarget"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LearnerProfile": {
        "properties": {
          "baseline_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Date"
          },
          "baseline_french_cefr": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline French Cefr"
          },
          "overall_french_cefr": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Overall French Cefr"
          },
          "speaking_cefr": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speaking Cefr"
          },
          "grammar_cefr": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grammar Cefr"
          },
          "vocabulary_cefr": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vocabulary Cefr"
          },
          "listening_cefr": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Listening Cefr"
          },
          "fluency_cefr": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fluency Cefr"
          },
          "strengths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Strengths",
            "default": []
          },
          "weaknesses": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Weaknesses",
            "default": []
          },
          "best_learning_methods": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Best Learning Methods",
            "default": []
          },
          "weak_learning_methods": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Weak Learning Methods",
            "default": []
          },
          "baseline": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline"
          },
          "active_vocabulary_count": {
            "type": "integer",
            "title": "Active Vocabulary Count",
            "default": 0
          },
          "learned_vocabulary_count": {
            "type": "integer",
            "title": "Learned Vocabulary Count",
            "default": 0
          },
          "active_grammar_count": {
            "type": "integer",
            "title": "Active Grammar Count",
            "default": 0
          },
          "stable_grammar_count": {
            "type": "integer",
            "title": "Stable Grammar Count",
            "default": 0
          }
        },
        "type": "object",
        "title": "LearnerProfile"
      },
      "LearningProgress": {
        "properties": {
