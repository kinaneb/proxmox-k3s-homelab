HOMELAB_SUBNET=192.0.2.0/24
HOMELAB_GATEWAY=192.0.2.1
HOMELAB_DNS=192.0.2.53
K3S_API_ADDRESS=192.0.2.10
K3S_API_PORT=6443
REGISTRY_ENDPOINT=192.0.2.10:30500
FORGEJO_INSTANCE_URL=https://forgejo.example.invalid
FORGEJO_SSH_PORT=2222
PROXMOX_NODE_1_ADDRESS=192.0.2.21
PROXMOX_NODE_2_ADDRESS=192.0.2.22
PROXMOX_NODE_3_ADDRESS=192.0.2.23
STORAGE_ADDRESS=192.0.2.30
STORAGE_NFS_EXPORT=/srv/nfs
STORAGE_SMB_PATH=/srv/smb
TAILSCALE_GATEWAY_ADDRESS=192.0.2.40
